# Variables requeridas por el servicio web. Nunca guardar credenciales reales en Git.
NODE_ENV=production
DATABASE_URL=postgresql://usuario:clave@host:5432/base
CONTACT_EMAIL=contacto@pieldemar.com
DATA_RETENTION_DAYS=90
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=clave-smtp
# Opcional: si el proveedor exige un remitente distinto del usuario SMTP.
# SMTP_FROM=notificaciones@example.com
